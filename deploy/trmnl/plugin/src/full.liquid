{% if controller.reachable %}
{% assign machines_ok = machines.total | minus: machines.offline | minus: machines.stale %}
{% assign machines_value = machines_ok | append: "/" | append: machines.total %}
{% assign services_value = services.running | append: "/" | append: services.total %}
{% assign ops_label = "Failed ops, " | append: operations.hours | append: " h" %}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  <div class="grid grid--cols-4 gap--large">
    {% render "stat", label: "Machines OK", value: machines_value, trend: trends.machines_ok %}
    {% render "stat", label: "Services up", value: services_value, trend: trends.services_running %}
    {% render "stat", label: ops_label, value: operations.failed, trend: operations.hourly.failed %}
    {% render "stat", label: "Lab leases", value: lab.active, trend: trends.lab_active %}
  </div>
  <div class="fl-split">
    {% render "ops_chart", hourly: operations.hourly, height: 112 %}
    {% render "streak_block", streak: streak, trends: trends, availability_pct: availability_pct, spark_height: 44 %}
  </div>
  <div class="fl-split">
    {% render "attention_list", attention: attention, attention_count: attention_count, errors: errors, max: 5 %}
    <div class="fl-col gap--small">
      {% render "services_bar", services: services %}
      {% render "runway", domains: domains, max: 2 %}
    </div>
  </div>
</div>
{% else %}
  {% render "unreachable", updated: updated, availability_pct: availability_pct %}
{% endif %}
{% render "title", controller: controller, ok: ok, attention_count: attention_count, updated: updated %}
