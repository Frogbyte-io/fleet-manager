# /etc/fleet-trmnl/env
FLEET_URL=http://127.0.0.1:8080
FLEET_TRMNL_TIME_ZONE=Europe/Oslo
# FLEET_TRMNL_NAMES=0          # counts only: no machine, service or domain names leave the network
# FLEET_TRMNL_WINDOW_HOURS=24  # window for succeeded/failed operations
# FLEET_TRMNL_EXPIRY_DAYS=30   # flag domains expiring within this many days
# FLEET_TRMNL_MAX_BYTES=10000  # TRMNL+ accepts 10 KB instead of 5 KB
# FLEET_TRMNL_STATE_FILE=...   # trend history; the unit's StateDirectory is used by default
