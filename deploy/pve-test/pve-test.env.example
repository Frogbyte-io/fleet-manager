# Example configuration for deploy/pve-test/pve-test. Copy it OUTSIDE the
# repository, for example to ~/.config/fleet/pve-test.env (the default path;
# override with FLEET_PVE_TEST_ENV_FILE), chmod 600 it, and fill in the values.
# Every value below is a placeholder. Real addresses, host names, token IDs,
# fingerprints, and secrets never go into Git; this repository is public.

# --- Physical host --------------------------------------------------------
# SSH destination of the physical PVE host (root). Leave empty to run the
# script directly on that host as root.
FLEET_PVE_TEST_PHYS_SSH="root@<physical-host>"
# Storage for the nested VMs' disks and for ISO images, on the physical host.
FLEET_PVE_TEST_STORAGE="<vm-disk-storage>"
FLEET_PVE_TEST_ISO_STORAGE="<iso-storage>"
# Source ISOs, already downloaded and checksum-verified (runbook step 2).
FLEET_PVE_TEST_ISO_PVE8="<iso-storage>:iso/<proxmox-ve_8.4-N.iso>"
FLEET_PVE_TEST_ISO_CLUSTER="<iso-storage>:iso/<proxmox-ve_8.4-or-9.x.iso>"
# Bridge (and optional VLAN tag) the nested nodes attach to.
FLEET_PVE_TEST_BRIDGE="<bridge>"
FLEET_PVE_TEST_VLAN=""
# Sizing per nested node (defaults shown).
FLEET_PVE_TEST_CORES=4
FLEET_PVE_TEST_MEMORY_MB=8192
FLEET_PVE_TEST_DISK_GB=64

# --- Installer answers (shared) --------------------------------------------
FLEET_PVE_TEST_KEYBOARD="en-us"
FLEET_PVE_TEST_COUNTRY="<two-letter-country-code>"
FLEET_PVE_TEST_TIMEZONE="<Area/City>"
FLEET_PVE_TEST_MAILTO="<admin-mail>"
FLEET_PVE_TEST_GATEWAY="<gateway-address>"
FLEET_PVE_TEST_DNS="<dns-address>"
FLEET_PVE_TEST_NESTED_NIC="ens18"
# File holding a crypt(3) root password hash (for example from
# `openssl passwd -6`). Never the plain-text password.
FLEET_PVE_TEST_ROOT_PASSWORD_HASH_FILE="$HOME/.config/fleet/pve-test-root.hash"
# Public key(s) installed for root on every nested node.
FLEET_PVE_TEST_ROOT_SSH_PUBKEY_FILE="$HOME/.ssh/<key>.pub"
# Optional private key for every SSH connection the script makes (physical
# host and nested nodes). Unset: ssh's defaults, ~/.ssh/config, and the agent.
# FLEET_PVE_TEST_SSH_IDENTITY="$HOME/.ssh/<key>"

# --- Nested nodes ----------------------------------------------------------
# VMIDs on the physical host, FQDNs, and static addresses in CIDR form. The
# first label of the FQDN becomes the PVE node name.
FLEET_PVE_TEST_PVE8_VMID="<vmid>"
FLEET_PVE_TEST_PVE8_FQDN="<pve8-node>.<domain>"
FLEET_PVE_TEST_PVE8_CIDR="<address>/<prefix>"
FLEET_PVE_TEST_NODE_A_VMID="<vmid>"
FLEET_PVE_TEST_NODE_A_FQDN="<node-a>.<domain>"
FLEET_PVE_TEST_NODE_A_CIDR="<address>/<prefix>"
FLEET_PVE_TEST_NODE_B_VMID="<vmid>"
FLEET_PVE_TEST_NODE_B_FQDN="<node-b>.<domain>"
FLEET_PVE_TEST_NODE_B_CIDR="<address>/<prefix>"
# Optional per-node SSH destination (default root@<address from CIDR>).
# FLEET_PVE_TEST_NODE_A_SSH="root@<node-a>"
FLEET_PVE_TEST_CLUSTER_NAME="<cluster-name>"

# --- Tokens and local files --------------------------------------------------
FLEET_PVE_TEST_USER="fleet-test@pve"
FLEET_PVE_TEST_SECRET_DIR="$HOME/.config/fleet/pve-test-secrets"
# FLEET_PVE_TEST_KNOWN_HOSTS="$HOME/.config/fleet/pve-test-known_hosts"

# --- Values printed by `pve-test env` for FM-611 ----------------------------
FLEET_PVE_TEST_GUEST_STORAGE="local-lvm"
FLEET_PVE_TEST_GUEST_VMID_RANGE="<first>-<last>"
# FLEET_PVE_TEST_PVE8_TEMPLATE_VMID="<vmid>"
# FLEET_PVE_TEST_NODE_A_TEMPLATE_VMID="<vmid>"

# --- Failure simulation and timeouts ---------------------------------------
FLEET_PVE_TEST_DOWN_MODE="stop"
FLEET_PVE_TEST_INSTALL_TIMEOUT=1800
FLEET_PVE_TEST_BOOT_TIMEOUT=600
