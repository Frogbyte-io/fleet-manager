[Unit]
Description=Fleet Manager node daemon (fleetd)
Documentation=https://github.com/Frogbyte-io/fleet-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fleet
Group=fleet
UMask=0027
# The controller URL and the state directory are deployment facts, set by
# install.sh into /etc/default/fleetd. FLEETD_STATE_DIR is the packaging
# hook fleetd's state module documents (FM-211 owns the service layout).
EnvironmentFile=-/etc/default/fleetd
Environment=FLEETD_STATE_DIR=/var/lib/fleetd
ExecStart=/usr/local/bin/fleetd run --controller ${FLEETD_CONTROLLER_URL}
# The node daemon only ever makes outbound connections; restart with a
# bounded backoff so a controller outage cannot spin the service.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# StateDirectory creates /var/lib/fleetd owned by fleet:fleet (0750 here);
# the daemon itself tightens the directory and the node key to 0700 and the
# local status socket to 0660. Nothing else on the host is writable.
StateDirectory=fleetd
StateDirectoryMode=0750

# Hardening: the daemon needs no capabilities, no privilege escalation, no
# kernel or host interfaces beyond sockets and a private tmp. The address
# families are what an outbound WSS client plus a Unix socket require.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
# The hardware probe reads /proc/cpuinfo, /proc/meminfo, and the
# device-tree model — read-only, non-pid /proc must stay visible. The
# daemon never reads other processes' data.
# ProcSubset is deliberately not set: it would hide those files.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
