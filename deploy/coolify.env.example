# Configure these in the Coolify application, not as image build arguments.
# The key file and external Docker volume must already exist on that server.
FLEET_MASTER_KEY_SOURCE=/data/fleet-manager/secrets/master_key
FLEET_DATA_VOLUME=fleet-manager-data
FLEET_COOLIFY_PORT=8080
# Coolify-only: Coolify runs Compose with its project directory at the repository root,
# so the build context must be '.'. For a local `docker compose -f deploy/compose.coolify.yaml`
# (project directory `deploy/`), leave FLEET_BUILD_CONTEXT unset so the default '..' keeps the
# repository root as the context; '.' would look for deploy/deploy/controller.Dockerfile.
FLEET_BUILD_CONTEXT=.
# Optional M10 settings; unset keeps the controller's defaults.
# FLEET_DESIRED_FETCH_INTERVAL_SECONDS=300
# FLEET_REGISTRY_ENRICH_INTERVAL_SECONDS=86400
# FLEET_REGISTRY_EXPIRY_WINDOW_DAYS=30
# FLEET_ACTION_REQUEST_TTL_SECONDS=86400
# FLEET_ACTION_POLICY=
# FLEET_PERSISTENT_AUTO_POLICY=
