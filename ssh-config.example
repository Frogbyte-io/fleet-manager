# Example ~/.ssh/config entries for the registered machines.
# Copy into your actual ~/.ssh/config on each machine you want to reach them from,
# and point IdentityFile at whichever key is actually authorized on the target.
#
# Each machine gets two aliases: the plain name for LAN access, and a `-ts`
# suffixed one using its Tailscale IP for when you're off-LAN. Same host, same
# host key fingerprints — just pick whichever is reachable.

Host linux-dev
    HostName <lan-ip>
    User <user>
    IdentityFile ~/.ssh/<key>
    # accept-new pins the host key on first connect, so a later changed/spoofed
    # key fails loudly. The first connect is trust-on-first-use: compare the
    # fingerprint it records (ssh-keygen -lF <host>) with the one printed on
    # the target (ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub) before use.
    StrictHostKeyChecking accept-new

Host linux-dev-ts
    HostName <tailscale-ip>
    User <user>
    IdentityFile ~/.ssh/<key>
    StrictHostKeyChecking accept-new

Host windows-dev
    HostName <lan-ip>
    User <user>
    IdentityFile ~/.ssh/<key>
    StrictHostKeyChecking accept-new

Host windows-dev-ts
    HostName <tailscale-ip>
    User <user>
    IdentityFile ~/.ssh/<key>
    StrictHostKeyChecking accept-new
