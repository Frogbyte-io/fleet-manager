{
  "openapi": "3.1.0",
  "info": {
    "title": "Fleet Manager API",
    "description": "The public Fleet Manager control API. Mutations return durable operations; the controller-node channel is a separate, separately versioned protocol.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "version": "v1"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Returns the served API version.",
        "description": "This endpoint reads no state, requires no authorization, and creates no\noperation. It exists so the conventions in this crate are exercised end to\nend before any resource endpoint exists.",
        "operationId": "getMeta",
        "responses": {
          "200": {
            "description": "The API version this controller serves.",
            "headers": {
              "x-correlation-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Correlation identity of this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource_Meta"
                }
              }
            }
          },
          "400": {
            "description": "The supplied x-correlation-id header was not a canonical opaque Fleet identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Lists operations, newest first.",
        "description": "# Errors\n\nReturns the public error envelope on refusal or backend failure.",
        "operationId": "listOperations",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "The maximum number of operations to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of operations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_OperationDto"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not read operations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "operations"
        ],
        "summary": "Creates an operation.",
        "description": "# Errors\n\nReturns the public error envelope on refusal or backend failure.",
        "operationId": "createOperation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOperationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The operation was accepted and is durable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource_OperationDto"
                }
              }
            }
          },
          "400": {
            "description": "The request is malformed, or names an unknown kind.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not create operations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{id}": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Reads one operation.",
        "description": "# Errors\n\nReturns the public error envelope on refusal or backend failure.",
        "operationId": "getOperation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The operation's identity.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource_OperationDto"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not read operations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{id}/cancel": {
      "post": {
        "tags": [
          "operations"
        ],
        "summary": "Requests cancellation of an operation.",
        "description": "# Errors\n\nReturns the public error envelope on refusal or backend failure.",
        "operationId": "cancelOperation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The operation's identity.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cancellation request is durable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource_OperationDto"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not cancel operations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such live operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{id}/events": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "The live event stream of one operation: a fresh snapshot whenever the\noperation changes.",
        "description": "Reconnect protocol: the client sends `Last-Event-ID` with the last\nsnapshot's `updated_at`. Because snapshots are not archived, any change\nsince that cursor is announced as a `gap` event, and the client refetches\nthe operation before trusting the stream again. A terminal operation emits\nits final snapshot and closes the stream.\n\n# Errors\n\nReturns the public error envelope when the caller may not read the\noperation or it does not exist.",
        "operationId": "streamOperationEvents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The operation's identity.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A text/event-stream of operation snapshots, with `gap` markers after missed changes.",
            "content": {
              "text/event-stream": {}
            }
          },
          "403": {
            "description": "The caller may not read operations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Reads the system view.",
        "description": "# Errors\n\nReturns the public error envelope when the system source fails.\n\n# Panics\n\nPanics only if the pinned literal error code stops being valid syntax,\nwhich is a constant path a test pins.",
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "description": "What this controller is and how it is doing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          },
          "500": {
            "description": "A dependency could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "The body of every unsuccessful response.\n\nIt is built from [`PublicError`], which is the type that decides what is\nsafe to disclose. Internal causes, provider output, and secret values are\nexcluded there rather than filtered here.",
        "required": [
          "code",
          "message",
          "retry",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code. Clients branch on this, not on `message`.",
            "example": "malformed_correlation_id"
          },
          "correlationId": {
            "type": "string",
            "description": "The correlation identity of the request that failed. It is also returned\nin the `x-correlation-id` response header, and is what an operator needs\nto find the request in the audit trail.",
            "example": "01900a3c-b576-7287-a004-61d5b384a076"
          },
          "fieldViolations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "description": "Per-field rejections, when the failure is a validation failure."
          },
          "message": {
            "type": "string",
            "description": "Caller-safe human-readable summary."
          },
          "retry": {
            "$ref": "#/components/schemas/Retry",
            "description": "Retry guidance for this specific failure."
          }
        }
      },
      "CreateOperationRequest": {
        "type": "object",
        "description": "The body of the create-operation request.",
        "required": [
          "kind"
        ],
        "properties": {
          "deadlineAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The absolute deadline, in Unix epoch milliseconds, after which the\noperation must be treated as timed out. Absent means no deadline."
          },
          "idempotencyKey": {
            "type": [
              "string",
              "null"
            ],
            "description": "A caller-chosen key making this request idempotent: replaying it\nreturns the original operation instead of creating a second one.",
            "example": "bootstrap-2026-09-03"
          },
          "kind": {
            "type": "string",
            "description": "The kind of work to create; only kinds the controller can describe are\naccepted.",
            "example": "noop"
          },
          "payloadJson": {
            "type": [
              "string",
              "null"
            ],
            "description": "The bounded provider input for kinds that need one, e.g. the script\npayload of `ssh.exec`."
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "description": "One rejected input, identified by its location in the request body or query.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable reason this field was rejected.",
            "example": "invalid_slug"
          },
          "field": {
            "type": "string",
            "description": "JSON pointer into the request body, or a query parameter name.",
            "example": "/spec/name"
          },
          "message": {
            "type": "string",
            "description": "Caller-safe explanation."
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "Non-authoritative description of the API this controller serves.",
        "required": [
          "apiVersion",
          "service"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "The version segment of the served API path.",
            "example": "v1"
          },
          "service": {
            "type": "string",
            "description": "The service that answered, for operators reading a proxied response.",
            "example": "fleet-controller"
          }
        }
      },
      "OperationAccepted": {
        "type": "object",
        "description": "What a mutation returns instead of holding the request open.\n\nPer ADR-0002, a long infrastructure workflow is a durable operation the\ncaller polls or subscribes to, not an HTTP request kept alive for minutes.",
        "required": [
          "operationId",
          "status",
          "correlationId"
        ],
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Correlation identity shared by the request, the operation, and its audit\nevents.",
            "example": "01900a3c-b576-7287-a004-61d5b384a076"
          },
          "operationId": {
            "type": "string",
            "description": "Opaque identity of the durable operation.",
            "example": "01900a3c-e8a9-75ba-9337-94a8e6b7d3a9"
          },
          "status": {
            "$ref": "#/components/schemas/OperationStatus",
            "description": "The operation's state at the time the response was written."
          }
        }
      },
      "OperationDto": {
        "type": "object",
        "description": "The public operation resource. The application type is the transport\ntruth; this type is the documented shape, kept one `From` away so the two\ncannot drift silently.",
        "required": [
          "id",
          "kind",
          "state",
          "cancelRequested",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "cancelRequested": {
            "type": "boolean",
            "description": "Whether cancellation has been requested but not yet observed."
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The correlation identity joining this operation to the caller's flow."
          },
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time, in epoch milliseconds."
          },
          "deadlineAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The deadline, in epoch milliseconds, when one was set."
          },
          "errorJson": {
            "type": [
              "string",
              "null"
            ],
            "description": "The bounded public error, present when the operation failed."
          },
          "id": {
            "type": "string",
            "description": "The operation's identity."
          },
          "idempotencyKey": {
            "type": [
              "string",
              "null"
            ],
            "description": "The caller's idempotency key, when one was supplied."
          },
          "kind": {
            "type": "string",
            "description": "What kind of work this is.",
            "example": "noop"
          },
          "progressCurrent": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Progress numerator, when reported."
          },
          "progressMessage": {
            "type": [
              "string",
              "null"
            ],
            "description": "Bounded progress message, when reported."
          },
          "progressTotal": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Progress denominator, when reported."
          },
          "resultJson": {
            "type": [
              "string",
              "null"
            ],
            "description": "The bounded public result, present when the operation succeeded."
          },
          "state": {
            "type": "string",
            "description": "The current state: `pending`, `running`, `cancelling`, `succeeded`,\n`failed`, `cancelled`, or `timed_out`.",
            "example": "pending"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64",
            "description": "Last update, in epoch milliseconds."
          }
        }
      },
      "OperationStatus": {
        "type": "string",
        "description": "The lifecycle state of a durable operation.\n\nFM-108 owns the operation model itself. This enum exists so the accepted\nenvelope has a typed status from the start.",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "PageInfo": {
        "type": "object",
        "description": "Where a list response sits in its result set.\n\nPagination is cursor-based, never offset-based: an offset silently skips or\nrepeats rows when the underlying set changes between requests. The cursor is\nopaque, and a client that parses one is relying on an implementation detail\nthat is free to change.",
        "required": [
          "limit"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "The number of items this page was limited to.",
            "example": 50,
            "minimum": 0
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor for the next page, or `null` on the last page."
          }
        }
      },
      "Page_OperationDto": {
        "type": "object",
        "description": "A page of resources.\n\nThe concrete schema for a list endpoint appears when that endpoint does;\n[`PageInfo`] is the part of the shape that is fixed for every one of them.",
        "required": [
          "items",
          "page"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "The public operation resource. The application type is the transport\ntruth; this type is the documented shape, kept one `From` away so the two\ncannot drift silently.",
              "required": [
                "id",
                "kind",
                "state",
                "cancelRequested",
                "createdAt",
                "updatedAt"
              ],
              "properties": {
                "cancelRequested": {
                  "type": "boolean",
                  "description": "Whether cancellation has been requested but not yet observed."
                },
                "correlationId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The correlation identity joining this operation to the caller's flow."
                },
                "createdAt": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Creation time, in epoch milliseconds."
                },
                "deadlineAt": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64",
                  "description": "The deadline, in epoch milliseconds, when one was set."
                },
                "errorJson": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The bounded public error, present when the operation failed."
                },
                "id": {
                  "type": "string",
                  "description": "The operation's identity."
                },
                "idempotencyKey": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The caller's idempotency key, when one was supplied."
                },
                "kind": {
                  "type": "string",
                  "description": "What kind of work this is.",
                  "example": "noop"
                },
                "progressCurrent": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64",
                  "description": "Progress numerator, when reported."
                },
                "progressMessage": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Bounded progress message, when reported."
                },
                "progressTotal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64",
                  "description": "Progress denominator, when reported."
                },
                "resultJson": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The bounded public result, present when the operation succeeded."
                },
                "state": {
                  "type": "string",
                  "description": "The current state: `pending`, `running`, `cancelling`, `succeeded`,\n`failed`, `cancelled`, or `timed_out`.",
                  "example": "pending"
                },
                "updatedAt": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Last update, in epoch milliseconds."
                }
              }
            },
            "description": "The items on this page, in the endpoint's documented order."
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo",
            "description": "Where this page sits in the result set."
          }
        }
      },
      "Resource_Meta": {
        "type": "object",
        "description": "A single resource.\n\nThe payload is nested under `data` so that later top-level fields are an\nadditive change rather than a breaking one.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Non-authoritative description of the API this controller serves.",
            "required": [
              "apiVersion",
              "service"
            ],
            "properties": {
              "apiVersion": {
                "type": "string",
                "description": "The version segment of the served API path.",
                "example": "v1"
              },
              "service": {
                "type": "string",
                "description": "The service that answered, for operators reading a proxied response.",
                "example": "fleet-controller"
              }
            }
          }
        }
      },
      "Resource_OperationDto": {
        "type": "object",
        "description": "A single resource.\n\nThe payload is nested under `data` so that later top-level fields are an\nadditive change rather than a breaking one.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "The public operation resource. The application type is the transport\ntruth; this type is the documented shape, kept one `From` away so the two\ncannot drift silently.",
            "required": [
              "id",
              "kind",
              "state",
              "cancelRequested",
              "createdAt",
              "updatedAt"
            ],
            "properties": {
              "cancelRequested": {
                "type": "boolean",
                "description": "Whether cancellation has been requested but not yet observed."
              },
              "correlationId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The correlation identity joining this operation to the caller's flow."
              },
              "createdAt": {
                "type": "integer",
                "format": "int64",
                "description": "Creation time, in epoch milliseconds."
              },
              "deadlineAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "description": "The deadline, in epoch milliseconds, when one was set."
              },
              "errorJson": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The bounded public error, present when the operation failed."
              },
              "id": {
                "type": "string",
                "description": "The operation's identity."
              },
              "idempotencyKey": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The caller's idempotency key, when one was supplied."
              },
              "kind": {
                "type": "string",
                "description": "What kind of work this is.",
                "example": "noop"
              },
              "progressCurrent": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "description": "Progress numerator, when reported."
              },
              "progressMessage": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Bounded progress message, when reported."
              },
              "progressTotal": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "description": "Progress denominator, when reported."
              },
              "resultJson": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The bounded public result, present when the operation succeeded."
              },
              "state": {
                "type": "string",
                "description": "The current state: `pending`, `running`, `cancelling`, `succeeded`,\n`failed`, `cancelled`, or `timed_out`.",
                "example": "pending"
              },
              "updatedAt": {
                "type": "integer",
                "format": "int64",
                "description": "Last update, in epoch milliseconds."
              }
            }
          }
        }
      },
      "Retry": {
        "type": "string",
        "description": "Whether and how a caller may retry a failed request.",
        "enum": [
          "never",
          "immediate",
          "backoff"
        ]
      },
      "SystemInfo": {
        "type": "object",
        "description": "The system view served at `/api/v1/system`.",
        "required": [
          "service",
          "version",
          "trustMode",
          "trustWarning",
          "storageOk",
          "queuePending",
          "queueRunning"
        ],
        "properties": {
          "queuePending": {
            "type": "integer",
            "format": "int64",
            "description": "Operations accepted but not yet claimed."
          },
          "queueRunning": {
            "type": "integer",
            "format": "int64",
            "description": "Operations claimed and executing."
          },
          "service": {
            "type": "string",
            "description": "The service that answered.",
            "example": "fleet-controller"
          },
          "storageOk": {
            "type": "boolean",
