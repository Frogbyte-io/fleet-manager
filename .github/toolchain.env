# Pinned versions for everything CI installs that is not Rust. One line per
# tool; this file is the only place each version appears, so a bump is a
# one-line edit. Rust is pinned in ../rust-toolchain.toml instead, because
# rustup reads that file automatically.
#
# Loaded by .github/actions/setup-toolchain. Format is strict KEY=VALUE with no
# quoting, spaces, or expansion.
#
# Policy for changing these values: .github/toolchain-policy.md

NODE_VERSION=24.19.0
PNPM_VERSION=9.15.9
COREPACK_VERSION=0.35.0

# Supply-chain tooling. GITLEAKS_SHA256 is the sha256 of
# gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz from the upstream release and
# must be updated together with GITLEAKS_VERSION.
CARGO_DENY_VERSION=0.20.2
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# PowerShell 7, for the Windows guest script tests in fleet-provider-ssh.
# POWERSHELL_SHA256 is the sha256 of powershell-${POWERSHELL_VERSION}-linux-x64.tar.gz
# from the upstream release (its hashes.sha256 asset) and must be updated
# together with POWERSHELL_VERSION.
POWERSHELL_VERSION=7.6.7
POWERSHELL_SHA256=6896f9e3a6b0a354bf470835a96da76d2f801cd50dcf047ad7c4563bf93bf431
